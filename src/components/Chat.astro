---
interface Props {
  hint?: string
  suggestions?: string[]
  runId?: string
}
const {
  hint = 'El hilo queda aquí. Pregunta y sigue cada herramienta al vuelo.',
  suggestions = [
    '¿Cómo llego de piernas esta semana?',
    '¿Qué carrera me recomiendas antes de Valencia?',
    'Plan para los próximos 3 días',
  ],
  runId,
} = Astro.props
---

<aside class="chat" id="chat" data-run-id={runId}>
  <button
    class="grip"
    id="chat-resize"
    type="button"
    role="separator"
    aria-label="Cambiar tamaño del chat"
    aria-orientation="vertical"
    aria-controls="chat"
    aria-valuemin="52"
    aria-valuemax="720"
    aria-valuenow="416"
    title="Arrastra para cambiar el tamaño. Doble clic para plegar."
  >
    <i aria-hidden="true"></i>
  </button>
  <div class="pane">
    <button class="rail" id="chat-open" type="button" title="Abrir el chat" aria-expanded="true">
      <img class="face" src="/team/entrenador.webp" alt="" width="512" height="512" decoding="async" />
      <span class="pixel tag">Coach</span>
    </button>
    <div class="head">
      <button class="pixel ctx" id="chat-ctx" type="button" title="Forzar al ConversationManager a recortar el historial ahora">
        <span class="ctx-text">contexto · …</span>
      </button>
    </div>
    <div class="log" id="chat-log" aria-live="polite">
      <p class="hint">{hint}</p>
    </div>
    <form id="chat-form">
      <input id="chat-input" type="text" name="message" placeholder="Escríbele al coach…" autocomplete="off" required />
      <button class="btn" type="submit">Enviar</button>
    </form>
    <div class="chips">
      {suggestions.map((s) => <button type="button" class="chip" data-msg={s}>{s}</button>)}
    </div>
  </div>
</aside>
<script is:inline>
  (() => {
    const chat = document.getElementById('chat')
    if (!chat || window.matchMedia('(max-width: 960px)').matches) return
    const w = Number(localStorage.getItem('midu-chat-w'))
    if (Number.isFinite(w) && w >= 52) chat.style.width = `${w}px`
  })()
</script>

<script>
  const TOOLS: Record<string, string> = {
    queryTrainingLoadAssessment: 'Carga de entrenamiento',
    queryRecoveryStatus: 'Recuperación',
    querySportRecords: 'Entrenamientos',
    getActivityDetail: 'Detalle de la sesión',
    queryActivityLapData: 'Vueltas',
    queryFitnessAssessmentOverview: 'Fitness',
    querySleepData: 'Sueño',
    get_upcoming_races: 'Próximas carreras',
    save_race_prediction: 'Guardar predicción',
    guardar_preferencia: 'Guardar preferencia (estado)',
    ver_preferencias: 'Leer preferencias (estado)',
    recordar: 'Guardar en memoria',
    buscar_en_memoria: 'Buscar en memoria',
  }
  const TEAM: Record<string, string> = { fisio: 'Fisioterapeuta', nutricionista: 'Nutricionista' }
  const MANAGER: Record<string, string> = { 'sliding-window': 'ventana deslizante', summarizing: 'resumen' }

  const log = document.getElementById('chat-log')!
  const form = document.getElementById('chat-form') as HTMLFormElement
  const input = document.getElementById('chat-input') as HTMLInputElement
  const submit = form.querySelector('button')!
  const ctxBtn = document.getElementById('chat-ctx') as HTMLButtonElement
  const ctxText = ctxBtn.querySelector('.ctx-text')!
  const runId = () => document.getElementById('chat')?.dataset.runId || undefined

  const label = (name: string) => TOOLS[name] ?? name
  const fmtMs = (ms: number) => (ms < 1000 ? `${Math.round(ms)}ms` : `${(ms / 1000).toFixed(1)}s`)

  // Solo el log: scrollIntoView también mueve .app/.content y deja el hilo cortado
  const NEAR_BOTTOM = 64
  let pinned = true
  const isPinned = () => log.scrollHeight - log.scrollTop - log.clientHeight <= NEAR_BOTTOM
  const stick = (force = false) => {
    if (!force && !pinned) return
    log.scrollTop = log.scrollHeight
  }
  log.addEventListener('scroll', () => { pinned = isPinned() }, { passive: true })

  // Cabecera con cara y nombre de quien habla. El chat siempre es el entrenador; los especialistas tienen la suya.
  const speaker = (id: string, name: string) => {
    const head = document.createElement('div')
    head.className = 'speaker'
    const avatar = document.createElement('img')
    avatar.className = 'avatar'
    avatar.src = `/team/${id}.webp`
    avatar.alt = ''
    avatar.width = avatar.height = 512
    avatar.decoding = 'async'
    avatar.onerror = () => {
      const mono = document.createElement('i')
      mono.className = 'avatar mono pixel'
      mono.textContent = name.slice(0, 1)
      avatar.replaceWith(mono)
    }
    const who = document.createElement('span')
    who.className = 'who pixel'
    who.textContent = name
    head.append(avatar, who)
    return head
  }

  const add = (cls: string, text = '') => {
    const el = document.createElement('div')
    el.className = `msg ${cls}`
    if (cls.split(/\s+/).includes('bot')) {
      const body = document.createElement('span')
      body.className = 'body'
      body.textContent = text
      el.append(speaker('entrenador', 'Entrenador'), body)
    } else {
      el.textContent = text
    }
    log.append(el)
    stick(cls === 'user')
    return el
  }

  let thinking: HTMLElement | null = null

  const showThinking = () => {
    if (!thinking) {
      thinking = document.createElement('div')
      thinking.className = 'think'
      thinking.setAttribute('aria-busy', 'true')
      const px = document.createElement('i')
      px.className = 'px'
      px.setAttribute('aria-hidden', 'true')
      for (let i = 0; i < 4; i++) px.append(document.createElement('b'))
      const status = document.createElement('span')
      status.className = 'status'
      status.textContent = 'Pensando'
      thinking.append(px, status)
    }
    log.append(thinking)
    stick()
  }

  const hideThinking = () => {
    thinking?.remove()
    thinking = null
  }

  const startStream = (el: HTMLElement) => {
    el.classList.add('streaming')
    el.setAttribute('aria-busy', 'true')
  }

  const endStream = (el: HTMLElement | null) => {
    el?.classList.remove('streaming')
    el?.removeAttribute('aria-busy')
  }

  const write = (el: HTMLElement, chunk: string) => {
    const body = el.querySelector('.body') ?? el
    body.textContent += chunk
  }

  type Turn = { tools: HTMLUListElement | null; bot: HTMLElement | null }

  const toolList = (turn: Turn) => {
    if (!turn.tools || turn.bot) {
      const list = document.createElement('ul')
      list.className = 'tools'
      thinking ? thinking.before(list) : log.append(list)
      turn.tools = list
      turn.bot = null
    }
    return turn.tools
  }

  const pixels = () => {
    const px = document.createElement('i')
    px.className = 'px'
    px.setAttribute('aria-hidden', 'true')
    for (let i = 0; i < 4; i++) px.append(document.createElement('b'))
    return px
  }

  // Especialista (agent as tool): tarjeta con su nombre, la pregunta que le hace el entrenador,
  // sus propias tools y lo que va escribiendo, en vivo.
  const startAgent = (turn: Turn, id: string, name: string, input: string) => {
    const li = document.createElement('li')
    li.className = 'agent running'
    li.dataset.id = id
    li.setAttribute('aria-busy', 'true')
    const head = speaker(name, TEAM[name] ?? name)
    head.classList.add('agent-head')
    const ms = document.createElement('span')
    ms.className = 'ms'
    ms.textContent = '…'
    head.append(pixels(), ms)
    const ask = document.createElement('p')
    ask.className = 'ask'
    ask.textContent = input
    const tools = document.createElement('ul')
    tools.className = 'tools sub'
    const say = document.createElement('p')
    say.className = 'say'
    li.append(head, ask, tools, say)
    toolList(turn).append(li)
    stick()
  }

  const agentText = (id: string, text: string) => {
    const li = log.querySelector<HTMLElement>(`.agent[data-id="${CSS.escape(id)}"]`)
    const say = li?.querySelector('.say')
    if (!say) return
    say.textContent += text.replaceAll('**', '')
    stick()
  }

  const endAgent = (id: string, ms: number, ok: boolean) => {
    const li = log.querySelector<HTMLElement>(`.agent[data-id="${CSS.escape(id)}"]`)
    if (!li) return
    li.classList.remove('running')
    li.classList.add(ok ? 'done' : 'fail')
    li.removeAttribute('aria-busy')
    const time = li.querySelector('.agent-head .ms')
    if (time) time.textContent = fmtMs(ms)
  }

  const startTool = (turn: Turn, id: string, name: string, parent?: string) => {
    const host = parent
      ? log.querySelector<HTMLUListElement>(`.agent[data-id="${CSS.escape(parent)}"] .tools`) ?? toolList(turn)
      : toolList(turn)
    const li = document.createElement('li')
    li.className = 'tool running'
    li.dataset.id = id
    li.setAttribute('aria-busy', 'true')
    const row = document.createElement('button')
    row.type = 'button'
    row.className = 'row'
    row.disabled = true
    row.title = name
    const px = document.createElement('i')
    px.className = 'px'
    px.setAttribute('aria-hidden', 'true')
    for (let i = 0; i < 4; i++) px.append(document.createElement('b'))
    const nameEl = document.createElement('span')
    nameEl.className = 'name'
    nameEl.textContent = label(name)
    const ms = document.createElement('span')
    ms.className = 'ms'
    ms.textContent = '…'
    row.append(px, nameEl, ms)
    li.append(row)
    host.append(li)
    stick()
  }

  const endTool = (_turn: Turn, id: string, ms: number, ok: boolean, input?: unknown, output?: string) => {
    const li = log.querySelector<HTMLLIElement>(`.tool[data-id="${CSS.escape(id)}"]`)
    if (!li) return
    li.classList.remove('running')
    li.classList.add(ok ? 'done' : 'fail')
    li.removeAttribute('aria-busy')
    const time = li.querySelector('.ms')
    if (time) time.textContent = fmtMs(ms)

    const row = li.querySelector<HTMLButtonElement>('.row')
    if (!row || (input === undefined && !output)) return

    const io = document.createElement('div')
    io.className = 'io'
    if (input !== undefined) {
      const k = document.createElement('p')
      k.className = 'pixel k'
      k.textContent = 'entrada'
      const pre = document.createElement('pre')
      pre.textContent = typeof input === 'string' ? input : JSON.stringify(input, null, 2)
      io.append(k, pre)
    }
    if (output) {
      const k = document.createElement('p')
      k.className = 'pixel k'
      k.textContent = 'resultado'
      const pre = document.createElement('pre')
      pre.textContent = output
      io.append(k, pre)
    }
    const caret = document.createElement('span')
    caret.className = 'caret'
    caret.setAttribute('aria-hidden', 'true')
    caret.textContent = '+'
    row.append(caret)
    li.append(io)
    li.classList.add('has-out')
    row.disabled = false
    row.setAttribute('aria-expanded', 'false')
    row.addEventListener('click', () => {
      const open = li.classList.toggle('open')
      caret.textContent = open ? '–' : '+'
      row.setAttribute('aria-expanded', String(open))
      stick()
    })
  }

  type Ctx = { manager: string; sessionId: string; mensajes: number; ventana: number | null; recientes: number | null; resumen: string | null }

  const renderContext = (ctx: Ctx, cayeron = 0) => {
    const limit = ctx.ventana != null ? `/${ctx.ventana}` : ''
    ctxText.textContent = `contexto · ${ctx.mensajes}${limit} msgs · ${MANAGER[ctx.manager] ?? ctx.manager}`
    ctxBtn.classList.toggle('full', ctx.ventana != null && ctx.mensajes >= ctx.ventana)
    ctxBtn.classList.toggle('summary', Boolean(ctx.resumen))
    ctxBtn.title = ctx.resumen
      ? `Resumen activo:\n${ctx.resumen}`
      : `Sesión ${ctx.sessionId} en disco. Click: forzar recorte del historial ahora.`
    if (cayeron > 0) {
      const note = document.createElement('p')
      note.className = 'ctx-note'
      note.textContent = `Ventana deslizante: ${cayeron} mensaje${cayeron === 1 ? '' : 's'} antiguo${cayeron === 1 ? '' : 's'} fuera del contexto`
      log.append(note)
      stick()
    }
  }

  // Al cargar: contexto + historial restaurado de la sesión en disco (SessionManager)
  fetch(`/api/context${runId() ? `?runId=${runId()}` : ''}`)
    .then((r) => (r.ok ? r.json() : null))
    .then((ctx) => {
      if (!ctx) return
      const history: { role: string; text: string }[] = ctx.historial ?? []
      if (history.length) {
        log.querySelector('.hint')?.remove()
        const note = document.createElement('p')
        note.className = 'ctx-note restored'
        note.textContent = `Sesión ${ctx.sessionId} restaurada de disco · ${ctx.mensajes} mensajes`
        log.append(note)
        for (const m of history) add(m.role === 'user' ? 'user' : 'bot', m.text.replaceAll('**', ''))
        stick(true)
      }
      renderContext(ctx)
    })
    .catch(() => {})

  ctxBtn.addEventListener('click', async () => {
    ctxBtn.disabled = true
    ctxText.textContent = 'contexto · recortando…'
    try {
      const res = await fetch('/api/context', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ runId: runId() }) })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error ?? res.statusText)
      renderContext(data)
      const note = document.createElement('p')
      note.className = 'ctx-note'
      note.textContent = data.reducido
        ? data.resumen
          ? `Historial resumido: ${data.antes} → ${data.mensajes} mensajes. El resumen sustituye a lo antiguo.`
          : `Historial recortado: ${data.antes} → ${data.mensajes} mensajes.`
        : `Nada que recortar (${data.mensajes} mensajes).`
      log.append(note)
      if (data.resumen) {
        const sum = document.createElement('p')
        sum.className = 'ctx-summary'
        sum.textContent = data.resumen
        log.append(sum)
      }
      stick(true)
    } catch (err) {
      ctxText.textContent = `contexto · ${(err as Error).message}`
    } finally {
      ctxBtn.disabled = false
    }
  })

  async function send(message: string) {
    log.querySelector('.hint')?.remove()
    add('user', message)
    const turn: Turn = { tools: null, bot: null }
    showThinking()
    submit.disabled = true
    input.value = ''
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message, runId: document.getElementById('chat')?.dataset.runId || undefined }),
      })
      if (!res.ok || !res.body) throw new Error((await res.json().catch(() => ({}))).error ?? res.statusText)
      const reader = res.body.getReader()
      const decoder = new TextDecoder()
      let buffer = ''
      for (;;) {
        const { value, done } = await reader.read()
        if (done) break
        buffer += decoder.decode(value, { stream: true })
        const lines = buffer.split('\n')
        buffer = lines.pop() ?? ''
        for (const line of lines) {
          if (!line.trim()) continue
          const chunk = JSON.parse(line)
          if (chunk.type === 'text') {
            if (!turn.bot) {
              hideThinking()
              turn.bot = add('bot')
              startStream(turn.bot)
            }
            write(turn.bot, chunk.text.replaceAll('**', ''))
            stick()
          } else if (chunk.type === 'tool_start') {
            startTool(turn, chunk.id, chunk.name, chunk.parent)
            if (!turn.bot) showThinking()
          } else if (chunk.type === 'tool_end') {
            endTool(turn, chunk.id, chunk.ms, chunk.ok !== false, chunk.input, chunk.output)
          } else if (chunk.type === 'agent_start') {
            startAgent(turn, chunk.id, chunk.name, chunk.input)
            if (!turn.bot) showThinking()
          } else if (chunk.type === 'agent_text') {
            agentText(chunk.id, chunk.text)
          } else if (chunk.type === 'agent_end') {
            endAgent(chunk.id, chunk.ms, chunk.ok !== false)
          } else if (chunk.type === 'context') {
            renderContext(chunk.context, chunk.cayeron)
          } else if (chunk.type === 'error') {
            if (!turn.bot) {
              hideThinking()
              turn.bot = add('bot')
            }
            write(turn.bot, `\n[error] ${chunk.message}`)
          }
        }
      }
      if (!turn.bot && !turn.tools) add('bot', '')
    } catch (err) {
      hideThinking()
      add('bot', `Error: ${(err as Error).message}`)
    } finally {
      hideThinking()
      endStream(turn.bot)
      submit.disabled = false
      input.focus()
      // El panel de estado/memoria se refresca solo (la extracción de memoria corre en segundo plano)
      document.dispatchEvent(new CustomEvent('coach:turn'))
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const message = input.value.trim()
    if (message) send(message)
  })
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.addEventListener('click', () => send(c.dataset.msg!)))

  const KEY_W = 'midu-chat-w'
  const KEY_OPEN = 'midu-chat-w-open'
  const COLLAPSED = 52
  const SNAP = 220
  const MIN_OPEN = 272
  const DEFAULT_W = 416
  const chatEl = document.getElementById('chat') as HTMLElement
  const grip = document.getElementById('chat-resize') as HTMLButtonElement
  const rail = document.getElementById('chat-open') as HTMLButtonElement
  const desktop = () => !window.matchMedia('(max-width: 960px)').matches
  const maxW = () => Math.min(720, Math.round(window.innerWidth * 0.52))
  const lastOpen = () => {
    const saved = Number(localStorage.getItem(KEY_OPEN))
    return Number.isFinite(saved) && saved >= MIN_OPEN ? saved : DEFAULT_W
  }
  const applyWidth = (px: number, persist = true) => {
    if (!desktop()) {
      chatEl.style.width = ''
      delete chatEl.dataset.collapsed
      return
    }
    let w = Math.round(px)
    if (w < SNAP) w = COLLAPSED
    else w = Math.min(maxW(), Math.max(MIN_OPEN, w))
    chatEl.style.width = `${w}px`
    chatEl.dataset.collapsed = w <= COLLAPSED ? 'true' : 'false'
    grip.setAttribute('aria-valuenow', String(w))
    grip.setAttribute('aria-valuemin', String(COLLAPSED))
    grip.setAttribute('aria-valuemax', String(maxW()))
    rail.setAttribute('aria-expanded', String(w > COLLAPSED))
    if (!persist) return
    localStorage.setItem(KEY_W, String(w))
    if (w > COLLAPSED) localStorage.setItem(KEY_OPEN, String(w))
  }

  applyWidth(chatEl.getBoundingClientRect().width, false)

  grip.addEventListener('pointerdown', (e) => {
    if (!desktop() || e.button !== 0) return
    e.preventDefault()
    try { grip.setPointerCapture(e.pointerId) } catch {}
    chatEl.classList.add('is-resizing')
    document.body.classList.add('chat-resizing')
    const startX = e.clientX
    const startW = chatEl.getBoundingClientRect().width
    const onMove = (ev: PointerEvent) => applyWidth(startW + (startX - ev.clientX), false)
    const onUp = (ev: PointerEvent) => {
      if (ev.pointerId !== e.pointerId) return
      grip.releasePointerCapture(ev.pointerId)
      grip.removeEventListener('pointermove', onMove)
      grip.removeEventListener('pointerup', onUp)
      grip.removeEventListener('pointercancel', onUp)
      chatEl.classList.remove('is-resizing')
      document.body.classList.remove('chat-resizing')
      applyWidth(chatEl.getBoundingClientRect().width)
    }
    grip.addEventListener('pointermove', onMove)
    grip.addEventListener('pointerup', onUp)
    grip.addEventListener('pointercancel', onUp)
  })
  grip.addEventListener('dblclick', () => {
    if (!desktop()) return
    applyWidth(chatEl.dataset.collapsed === 'true' ? lastOpen() : COLLAPSED)
  })
  grip.addEventListener('keydown', (e) => {
    if (!desktop()) return
    const w = chatEl.getBoundingClientRect().width
    const step = e.shiftKey ? 80 : 24
    if (e.key === 'ArrowLeft') { e.preventDefault(); applyWidth(w + step) }
    if (e.key === 'ArrowRight') { e.preventDefault(); applyWidth(w - step) }
    if (e.key === 'Home') { e.preventDefault(); applyWidth(COLLAPSED) }
    if (e.key === 'End') { e.preventDefault(); applyWidth(maxW()) }
  })
  rail.addEventListener('click', () => applyWidth(lastOpen()))
  window.addEventListener('resize', () => {
    if (!desktop()) {
      chatEl.style.width = ''
      delete chatEl.dataset.collapsed
      return
    }
    const w = chatEl.getBoundingClientRect().width
    if (w > maxW()) applyWidth(maxW())
  })
</script>

<style>
  .chat {
    position: relative;
    display: flex;
    flex-direction: column;
    width: var(--chat-w, min(26rem, 36vw));
    min-width: 3.25rem;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    background: var(--bg);
    border-left: 1px solid var(--line);
    container-type: inline-size;
    container-name: chat;
    transition: width 0.18s ease;
  }
  .chat.is-resizing {
    transition: none;
  }
  .grip {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 12px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: col-resize;
    touch-action: none;
  }
  .grip::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: transparent;
    transition: background 0.15s, width 0.15s, box-shadow 0.15s;
  }
  .grip:hover::after,
  .chat.is-resizing .grip::after,
  .grip:focus-visible::after {
    width: 2px;
    background: var(--accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .grip:focus-visible {
    outline: none;
  }
  .grip i {
    position: absolute;
    left: 3px;
    top: 50%;
    width: 3px;
    height: 18px;
    transform: translateY(-50%);
    background: repeating-linear-gradient(to bottom, var(--faint) 0 2px, transparent 2px 4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }
  .chat:hover .grip i,
  .grip:hover i,
  .chat.is-resizing .grip i {
    opacity: 1;
  }
  .pane {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    padding: 1.25rem 1.15rem 1rem;
  }
  .rail {
    display: none;
  }
  .head {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    flex-shrink: 0;
    margin-bottom: 0.75rem;
  }
  .ctx {
    padding: 0.2rem 0.45rem;
    font-size: 0.6rem;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--faint);
    white-space: nowrap;
  }
  .ctx:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
  .ctx.full {
    color: var(--warn);
    border-color: #5a4a10;
  }
  .ctx.summary {
    color: var(--ok);
  }
  .ctx:disabled {
    opacity: 0.6;
  }
  .log :global(.ctx-note) {
    margin: 0;
    padding: 0.35rem 0.5rem;
    border: 1px dashed var(--line);
    color: var(--warn);
    font-family: var(--font-pixel);
    font-size: 0.6rem;
