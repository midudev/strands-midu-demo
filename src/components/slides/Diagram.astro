---
// Diagramas SVG de las slides. Todo en vectores con los colores de la web para que escalen a cualquier pantalla.
interface Props {
  kind: 'loop' | 'tools' | 'hooks' | 'memory' | 'team' | 'swarm'
}
const { kind } = Astro.props
---

{
  kind === 'loop' && (
    <svg class="diagram" viewBox="0 0 960 330" role="img" aria-label="El loop del agente: usuario, modelo, tools">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" fill="currentColor" />
        </marker>
      </defs>
      <g class="box">
        <rect x="30" y="130" width="170" height="64" />
        <text x="115" y="168">usuario</text>
      </g>
      <g class="box hi">
        <rect x="395" y="130" width="170" height="64" />
        <text x="480" y="168">modelo</text>
      </g>
      <g class="box">
        <rect x="760" y="130" width="170" height="64" />
        <text x="845" y="168">tools</text>
      </g>
      <g class="arrow">
        <path d="M200 150 H395" />
        <text x="297" y="140">prompt</text>
      </g>
      <g class="arrow accent">
        <path d="M565 150 H760" />
        <text x="662" y="140">toolUse</text>
      </g>
      <g class="arrow accent">
        <path d="M760 176 H565" />
        <text x="662" y="200" class="under">toolResult</text>
      </g>
      <g class="arrow">
        <path d="M395 176 H200" />
        <text x="297" y="200" class="under">respuesta</text>
      </g>
      <g class="arrow accent dashed">
        <path d="M600 194 Q662 290 724 194" />
        <text x="662" y="275" class="under">x N vueltas</text>
      </g>
      <g class="note">
        <text x="480" y="60">
          agent.invoke('¿Qué entreno hoy?')
        </text>
        <text x="480" y="90" class="mut">
          el modelo decide qué tool llama y cuándo ha terminado
        </text>
      </g>
      <g class="note">
        <text x="845" y="245" class="mut small">queryRecoveryStatus</text>
        <text x="845" y="268" class="mut small">querySportRecords</text>
        <text x="845" y="291" class="mut small">get_upcoming_races</text>
      </g>
    </svg>
  )
}

{
  kind === 'tools' && (
    <svg class="diagram" viewBox="0 0 520 380" role="img" aria-label="El agente con tools locales y un servidor MCP">
      <defs>
        <marker id="arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" fill="currentColor" />
        </marker>
      </defs>
      <g class="box hi">
        <rect x="170" y="20" width="180" height="60" />
        <text x="260" y="56">Agent</text>
      </g>
      <g class="arrow">
        <path d="M215 80 V150" />
        <path d="M305 80 V150" />
      </g>
      <g class="box">
        <rect x="20" y="150" width="230" height="52" />
        <text x="135" y="182" class="small">get_upcoming_races</text>
      </g>
      <g class="box">
        <rect x="20" y="212" width="230" height="52" />
        <text x="135" y="244" class="small">save_race_prediction</text>
      </g>
      <text x="135" y="290" class="mut small">tool() · función + schema Zod</text>
      <g class="box dashed">
        <rect x="270" y="150" width="230" height="200" />
        <text x="385" y="180" class="small accent-t">McpClient · COROS</text>
      </g>
      <g class="mini">
        <rect x="290" y="198" width="190" height="26" />
        <text x="385" y="216">queryFitnessAssessment</text>
        <rect x="290" y="232" width="190" height="26" />
        <text x="385" y="250">queryRecoveryStatus</text>
        <rect x="290" y="266" width="190" height="26" />
        <text x="385" y="284">querySportRecords</text>
        <rect x="290" y="300" width="190" height="26" />
        <text x="385" y="318">querySleepData · …</text>
      </g>
      <text x="385" y="372" class="mut small">servidor remoto · OAuth · listTools()</text>
    </svg>
  )
}

{
  kind === 'hooks' && (
    <svg class="diagram" viewBox="0 0 520 400" role="img" aria-label="Hooks a lo largo del loop del agente">
      <defs>
        <marker id="arrow-h" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" fill="currentColor" />
        </marker>
      </defs>
      <g class="rail">
        <path d="M120 40 V370" />
      </g>
      <g class="hook">
        <rect x="30" y="24" width="180" height="34" />
        <text x="120" y="46">BeforeInvocation</text>
        <text x="230" y="46" class="side">invocationState.toolsUsadas = []</text>
      </g>
      <g class="box">
        <rect x="60" y="86" width="120" height="40" />
        <text x="120" y="111">modelo</text>
      </g>
      <g class="hook">
        <rect x="30" y="154" width="180" height="34" />
        <text x="120" y="176">BeforeToolCall</text>
        <text x="230" y="168" class="side">corrige el input · o cancela:</text>
        <text x="230" y="188" class="side accent-t">event.cancel = 'motivo'</text>
      </g>
      <g class="box">
        <rect x="60" y="216" width="120" height="40" />
        <text x="120" y="241">tool</text>
      </g>
      <g class="hook">
        <rect x="30" y="284" width="180" height="34" />
        <text x="120" y="306">AfterToolCall</text>
        <text x="230" y="298" class="side">traza · guarda datos en state</text>
        <text x="230" y="318" class="side">o reescribe event.result</text>
      </g>
      <g class="hook">
        <rect x="30" y="346" width="180" height="34" />
        <text x="120" y="368">AfterInvocation</text>
        <text x="230" y="368" class="side">métricas · limpieza</text>
      </g>
      <g class="arrow accent dashed">
        <path d="M60 236 Q10 236 10 171 Q10 106 60 106" />
      </g>
    </svg>
  )
}

{
  kind === 'memory' && (
    <svg class="diagram" viewBox="0 0 560 400" role="img" aria-label="Las tres capas: contexto, sesión y memoria">
      <g class="layer">
        <rect x="20" y="20" width="520" height="100" />
        <text x="40" y="48" class="title">1 · ConversationManager</text>
        <text x="40" y="72" class="mut small">qué mensajes ve el modelo en este turno</text>
        <g class="msgs">
          <rect x="40" y="88" width="34" height="18" class="gone" />
          <rect x="80" y="88" width="34" height="18" class="gone" />
          <rect x="120" y="88" width="34" height="18" class="gone" />
          <rect x="172" y="88" width="34" height="18" />
          <rect x="212" y="88" width="34" height="18" />
          <rect x="252" y="88" width="34" height="18" />
          <rect x="292" y="88" width="34" height="18" />
          <rect x="332" y="88" width="34" height="18" />
          <rect x="372" y="88" width="34" height="18" />
        </g>
        <text x="420" y="102" class="small accent-t">ventana · o resumen</text>
      </g>
      <g class="layer">
        <rect x="20" y="140" width="520" height="100" />
        <text x="40" y="168" class="title">2 · SessionManager</text>
        <text x="40" y="192" class="mut small">snapshot del agente en disco tras cada turno · reinicias y sigue</text>
        <text x="40" y="222" class="mono">data/strands/sessions/coach-chat/…/snapshot_latest.json</text>
      </g>
      <g class="layer">
        <rect x="20" y="260" width="520" height="100" />
        <text x="40" y="288" class="title">3 · MemoryManager</text>
        <text x="40" y="312" class="mut small">hechos duraderos extraídos por el modelo · se inyectan si son relevantes</text>
        <text x="40" y="342" class="mono">"midu hace la tirada larga los domingos" · "molestia en el sóleo"</text>
      </g>
      <text x="40" y="388" class="small mut start">+ appState: contadores y preferencias que el modelo no ve en el contexto</text>
    </svg>
  )
}

{
  kind === 'team' && (
    <svg class="diagram" viewBox="0 0 560 360" role="img" aria-label="Agent as tool: el entrenador consulta al fisio y al nutricionista">
      <defs>
        <marker id="arrow-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" fill="currentColor" />
        </marker>
      </defs>
      <g class="box">
        <rect x="20" y="40" width="120" height="50" />
        <text x="80" y="70">midu</text>
      </g>
      <g class="arrow">
        <path d="M140 58 H210" />
        <path d="M210 72 H140" />
      </g>
      <g class="box hi">
        <rect x="210" y="30" width="180" height="70" />
        <text x="300" y="60">entrenador</text>
        <text x="300" y="84" class="small mut">Agent · chat</text>
      </g>
      <g class="arrow accent">
        <path d="M260 100 V200" />
        <path d="M340 100 V200" />
        <text x="300" y="158" class="under">asTool()</text>
      </g>
      <g class="box">
        <rect x="120" y="200" width="160" height="70" />
        <text x="200" y="230">fisio</text>
        <text x="200" y="254" class="small mut">Agent · su prompt</text>
      </g>
      <g class="box">
        <rect x="320" y="200" width="200" height="70" />
        <text x="420" y="230">nutricionista</text>
        <text x="420" y="254" class="small mut">Agent · su prompt</text>
      </g>
      <g class="arrow">
        <path d="M200 270 V310" />
        <path d="M420 270 V310" />
        <path d="M300 100 V120" class="hidden" />
      </g>
      <g class="box dashed">
        <rect x="120" y="310" width="400" height="36" />
        <text x="320" y="333" class="small">McpClient · COROS (compartido)</text>
      </g>
      <text x="470" y="60" class="small mut start">
        el modelo elige
      </text>
      <text x="470" y="80" class="small mut start">
        a quién preguntar
      </text>
    </svg>
  )
}

{
  kind === 'swarm' && (
    <svg class="diagram" viewBox="0 0 960 230" role="img" aria-label="Swarm: analista, optimista, conservador y árbitro se pasan el testigo">
      <defs>
        <marker id="arrow-s" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" fill="currentColor" />
        </marker>
      </defs>
      <g class="box hi">
        <rect x="20" y="70" width="180" height="70" />
        <text x="110" y="100">analista</text>
        <text x="110" y="124" class="small mut">lee COROS</text>
      </g>
      <g class="box">
        <rect x="270" y="70" width="180" height="70" />
        <text x="360" y="100">optimista</text>
        <text x="360" y="124" class="small mut">mejor tiempo creíble</text>
      </g>
      <g class="box">
        <rect x="520" y="70" width="180" height="70" />
        <text x="610" y="100">conservador</text>
        <text x="610" y="124" class="small mut">carga · Valencia</text>
      </g>
      <g class="box">
        <rect x="770" y="70" width="180" height="70" />
        <text x="860" y="100">árbitro</text>
        <text x="860" y="124" class="small mut">decide y guarda</text>
      </g>
      <g class="arrow accent">
        <path d="M200 105 H270" />
        <path d="M450 105 H520" />
        <path d="M700 105 H770" />
        <text x="235" y="60">handoff</text>
        <text x="485" y="60">handoff</text>
        <text x="735" y="60">handoff</text>
      </g>
      <g class="arrow dashed">
        <path d="M860 140 Q860 200 480 200 Q110 200 110 140" />
        <text x="480" y="192" class="under mut">"me falta un dato" · vuelve al analista</text>
      </g>
      <text x="480" y="30" class="mut small">
        cada handoff lleva context: distanciaKm, prediccionCoros, tiempoOptimista…
      </text>
    </svg>
  )
}

<style>
  .diagram {
    width: 100%;
    height: auto;
    max-height: 62vh;
    display: block;
    font-family: var(--font-pixel);
    font-feature-settings: 'calt' 0, 'liga' 0, 'ss01' 0;
    color: var(--muted);
    overflow: visible;
  }
  text {
    fill: var(--fg);
    font-size: 17px;
    text-anchor: middle;
    dominant-baseline: auto;
  }
  .small {
    font-size: 13px;
  }
  .mut {
    fill: var(--muted);
  }
  .accent-t {
    fill: var(--accent);
  }
  .mono {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12.5px;
    fill: var(--muted);
    text-anchor: start;
  }
  .box rect {
    fill: var(--bg-2);
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .box.hi rect {
    stroke: var(--accent);
  }
  .box.dashed rect {
    fill: transparent;
    stroke: var(--faint);
    stroke-dasharray: 4 4;
  }
  .mini rect {
    fill: var(--bg);
    stroke: var(--line);
  }
  .mini text {
    font-size: 11.5px;
    fill: var(--muted);
  }
  .arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    marker-end: url(#arrow);
  }
  .arrow path.hidden {
    display: none;
  }
  /* cada svg tiene su marker con id propio; los mapeamos aquí */
  svg[aria-label^='El agente con'] .arrow path {
    marker-end: url(#arrow-t);
  }
  svg[aria-label^='Hooks'] .arrow path {
    marker-end: url(#arrow-h);
  }
  svg[aria-label^='Agent as tool'] .arrow path {
    marker-end: url(#arrow-m);
  }
  svg[aria-label^='Swarm'] .arrow path {
    marker-end: url(#arrow-s);
  }
  .arrow text {
    font-size: 13px;
    fill: var(--muted);
  }
  .arrow.accent {
    color: var(--accent);
  }
  .arrow.accent text {
    fill: var(--accent);
  }
  .arrow.dashed path {
    stroke-dasharray: 5 5;
  }
  .note text {
    font-size: 15px;
  }
  .rail path {
    stroke: var(--line);
    stroke-width: 2;
    fill: none;
  }
  .hook rect {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .hook text {
    font-size: 13px;
    fill: var(--accent);
  }
  .hook .side {
    text-anchor: start;
    fill: var(--muted);
    font-size: 12.5px;
  }
  .layer rect {
    fill: var(--bg-2);
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .layer .title {
    text-anchor: start;
    font-size: 16px;
  }
  .layer .small,
  .layer .mut {
    text-anchor: start;
  }
  .layer .accent-t {
    text-anchor: start;
  }
  .msgs rect {
    fill: var(--fg);
    opacity: 0.85;
  }
  .msgs rect.gone {
    fill: transparent;
    stroke: var(--faint);
    stroke-dasharray: 3 3;
    opacity: 1;
  }
  .start {
    text-anchor: start;
  }
</style>
