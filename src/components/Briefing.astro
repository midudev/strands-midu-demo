---
// El briefing lo genera el agente (structured output de Strands): semáforo, sesión de hoy por bloques
// y plan de 7 días. La semana pasada sale de COROS (sin LLM) y se pinta en el servidor; el plan lo pide el cliente.
import type { Run } from '../agent/coros/data'

interface Props {
  runs: Run[]
}
const { runs } = Astro.props

const hoy = new Date().toISOString().slice(0, 10)
const DIAS = ['D', 'L', 'M', 'X', 'J', 'V', 'S']
const diaSemana = (f: string) => DIAS[new Date(`${f}T12:00:00`).getDay()]
const addDays = (f: string, n: number) => new Date(Date.parse(`${f}T12:00:00`) + n * 86400_000).toISOString().slice(0, 10)

// Últimos 7 días (sin hoy): km reales por día
const pasado = Array.from({ length: 7 }, (_, i) => {
  const fecha = addDays(hoy, i - 7)
  const km = runs.filter((r) => r.fecha === fecha).reduce((s, r) => s + r.km, 0)
  return { fecha, km: Math.round(km * 10) / 10, dia: diaSemana(fecha) }
})
const futuro = Array.from({ length: 7 }, (_, i) => {
  const fecha = addDays(hoy, i)
  return { fecha, dia: diaSemana(fecha) }
})
const maxPasado = Math.max(...pasado.map((d) => d.km), 1)
---

<section class="briefing" id="briefing" data-hoy={hoy} data-max={maxPasado}>
  <div class="head">
    <p class="label">Briefing del coach · hoy</p>
    <div class="actions">
      <span class="semaforo pixel" data-tone="" hidden><i></i><b></b></span>
      <button class="btn ghost" id="briefing-refresh" type="button">Regenerar</button>
    </div>
  </div>

  <div class="body" data-state="loading">
    <p class="pixel titular skeleton">Atándose las zapatillas…</p>
    <p class="motivo"></p>

    <div class="grid">
      <article class="card sesion">
        <div class="card-head">
          <p class="label">Sesión de hoy</p>
          <p class="pixel total"><b class="km">—</b><span> km · </span><b class="tiempo">—</b></p>
        </div>
        <p class="nombre"></p>
        <div class="segments" role="img" aria-label="Bloques de la sesión"></div>
        <div class="pixels" aria-hidden="true">
          {Array.from({ length: 48 }, (_, i) => <i style={`--d: ${((i * 37) % 48) * 45}ms`} />)}
        </div>
        <ul class="bloques"></ul>
      </article>

      <article class="card semana">
        <div class="card-head">
          <p class="label">Hecho · <span class="plan-label">plan del coach</span></p>
          <p class="pixel total"><b class="km-semana">—</b><span> km próximos 7 días</span></p>
        </div>
        <div class="chart">
          <div class="cols">
            {
              pasado.map((d) => (
                <div class="col hecho" data-km={d.km} data-tip={`${d.dia} · ${d.km ? `${d.km} km hechos` : 'sin salida'}`}>
                  <span class="num"></span>
                  <div class="bar" style={`--h: ${(d.km / maxPasado) * 100}%`} />
                  <span class="dia">{d.dia}</span>
                </div>
              ))
            }
            <div class="divider" aria-hidden="true"></div>
            {
              futuro.map((d, i) => (
                <div class:list={['col', 'plan', { today: i === 0 }]} data-fecha={d.fecha}>
                  <span class="num"></span>
                  <div class="bar skeleton" style="--h: 35%" />
                  <span class="dia">{i === 0 ? 'HOY' : d.dia}</span>
                </div>
              ))
            }
          </div>
        </div>
        <ul class="legend">
          <li><i class="sw hecho"></i>Hecho (COROS)</li>
          <li><i class="sw suave"></i>Suave</li>
          <li><i class="sw rodaje"></i>Rodaje</li>
          <li><i class="sw calidad"></i>Calidad</li>
          <li><i class="sw tirada"></i>Tirada</li>
        </ul>
      </article>
    </div>

    <p class="pixel tools"></p>
    <div class="tip" role="tooltip" hidden></div>
  </div>
</section>

<script>
  interface Bloque {
    tipo: 'calentamiento' | 'suave' | 'maraton' | 'umbral' | 'series' | 'enfriamiento'
    km: number
    ritmo: string
    nota?: string
  }
  interface Dia {
    fecha: string
    tipo: 'suave' | 'rodaje' | 'calidad' | 'tirada'
    km: number
    resumen: string
  }
  interface Briefing {
    titular: string
    semaforo: 'apretar' | 'controlar' | 'suave'
    motivo: string
    sesion: { nombre: string; bloques: Bloque[] }
    semana: Dia[]
    toolsUsadas?: string[]
  }

  const root = document.getElementById('briefing')!
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!
  const body = $('.body')
  const titular = $('.titular')
  const motivo = $('.motivo')
  const semaforo = $('.semaforo')
  const tools = $('.tools')
  const btn = $<HTMLButtonElement>('#briefing-refresh')
  const maxPasado = Number(root.dataset.max) || 1

  const SEMAFORO = { apretar: 'Apretar', controlar: 'Controlar', suave: 'Suave' }
  const FRASES = [
    'Atándose las zapatillas…',
    'Calentando…',
    'Mirando el cielo por si llueve…',
    'Contando los kilómetros de la semana…',
    'Afinando los ritmos…',
    'Decidiendo si hoy toca apretar…',
    'Dibujando la semana…',
    'Cuadrando la tirada larga…',
    'Pensando en Valencia…',
  ]
  let fraseTimer: number | undefined
  function startFrases() {
    let i = Math.floor(Math.random() * FRASES.length)
    titular.textContent = FRASES[i]
    fraseTimer = window.setInterval(() => {
      i = (i + 1) % FRASES.length
      titular.textContent = FRASES[i]
    }, 2200)
  }
  function stopFrases() {
    window.clearInterval(fraseTimer)
  }
  const TIPO = {
    calentamiento: 'Calentamiento',
    suave: 'Suave',
    maraton: 'Ritmo maratón',
    umbral: 'Umbral',
    series: 'Series',
    enfriamiento: 'Enfriamiento',
  }

  const paceSecs = (r: string) => {
    const parts = r.split(/[–-]/).map((p) => {
      const [m, s] = p.split(':').map(Number)
      return m * 60 + (s || 0)
    })
    return parts.reduce((a, b) => a + b, 0) / parts.length
  }
  const fmtTime = (secs: number) => {
    const h = Math.floor(secs / 3600)
    const m = Math.round((secs % 3600) / 60)
    return h ? `${h}h${String(m).padStart(2, '0')}` : `${m}'`
  }
  const fmtKm = (km: number) => (Number.isInteger(km) ? String(km) : km.toFixed(1))
  const ritmoBonito = (r: string) => r.replace('-', '–')

  function paintSesion({ nombre, bloques }: Briefing['sesion']) {
    const totalKm = bloques.reduce((s, b) => s + b.km, 0)
    const totalSecs = bloques.reduce((s, b) => s + b.km * paceSecs(b.ritmo), 0)
    $('.sesion .km').textContent = fmtKm(totalKm)
    $('.sesion .tiempo').textContent = `~${fmtTime(totalSecs)}`
    $('.nombre').textContent = nombre

    const segments = $('.segments')
    segments.replaceChildren(
      ...bloques.map((b) => {
        const seg = document.createElement('div')
        seg.className = `seg ${b.tipo}`
        seg.style.flexGrow = String(b.km)
        seg.dataset.tip = `${TIPO[b.tipo]} · ${fmtKm(b.km)} km a ${ritmoBonito(b.ritmo)}/km${b.nota ? ` · ${b.nota}` : ''}`
        seg.innerHTML = `<span class="seg-km pixel">${fmtKm(b.km)}</span>`
        return seg
      }),
    )
    const lista = $('.bloques')
    lista.replaceChildren(
      ...bloques.map((b) => {
        const li = document.createElement('li')
        li.innerHTML =
          `<i class="sw ${b.tipo}"></i><span class="b-tipo"><strong>${TIPO[b.tipo]}</strong><em>${b.nota ?? ''}</em></span>` +
          `<b class="pixel">${fmtKm(b.km)} km</b><b class="pixel ritmo">${ritmoBonito(b.ritmo)}<small>/km</small></b>`
        return li
      }),
    )
  }

  function paintSemana(semana: Dia[]) {
    const kmPlan = semana.reduce((s, d) => s + d.km, 0)
    $('.km-semana').textContent = fmtKm(Math.round(kmPlan * 10) / 10)
    const max = Math.max(maxPasado, ...semana.map((d) => d.km), 1)
    root.querySelectorAll<HTMLElement>('.col.hecho').forEach((col) => {
      const km = Number(col.dataset.km) || 0
      col.querySelector<HTMLElement>('.bar')!.style.setProperty('--h', `${(km / max) * 100}%`)
    })
    root.querySelectorAll<HTMLElement>('.col.plan').forEach((col, i) => {
      const d = semana[i]
      const bar = col.querySelector<HTMLElement>('.bar')!
      bar.className = `bar ${d?.tipo ?? ''}`
      bar.style.setProperty('--h', `${d ? (d.km / max) * 100 : 0}%`)
      col.querySelector('.num')!.textContent = d ? fmtKm(d.km) : ''
      if (d) col.dataset.tip = `${col.querySelector('.dia')!.textContent} · ${d.resumen}`
    })
  }

  function clearPlan() {
    root.querySelectorAll<HTMLElement>('.col.plan').forEach((col) => {
      const bar = col.querySelector<HTMLElement>('.bar')!
      bar.className = 'bar skeleton'
      bar.style.setProperty('--h', '35%')
      col.querySelector('.num')!.textContent = ''
      delete col.dataset.tip
    })
    $('.segments').replaceChildren()
    $('.bloques').replaceChildren()
    $('.nombre').textContent = ''
    $('.sesion .km').textContent = $('.sesion .tiempo').textContent = $('.km-semana').textContent = '—'
  }

  async function load(refresh = false) {
    body.dataset.state = 'loading'
    btn.disabled = true
    semaforo.hidden = true
    titular.classList.add('skeleton')
    startFrases()
    motivo.textContent = tools.textContent = ''
    clearPlan()
    try {
      const res = await fetch(`/api/briefing${refresh ? '?refresh' : ''}`)
      const data: Briefing & { error?: string } = await res.json()
      if (!res.ok) throw new Error(data.error ?? res.statusText)
      titular.textContent = data.titular
      motivo.textContent = data.motivo
      semaforo.dataset.tone = data.semaforo
      semaforo.querySelector('b')!.textContent = SEMAFORO[data.semaforo]
      semaforo.hidden = false
      paintSesion(data.sesion)
      paintSemana(data.semana)
      tools.textContent = data.toolsUsadas?.length ? `TOOLS · ${data.toolsUsadas.join(' · ')}` : ''
      body.dataset.state = 'ready'
    } catch (err) {
      titular.textContent = 'El coach no ha podido preparar el briefing.'
      motivo.textContent = (err as Error).message
      body.dataset.state = 'error'
    } finally {
      stopFrases()
      titular.classList.remove('skeleton')
      btn.disabled = false
    }
  }

  // Tooltip único para segmentos y barras
  const tip = $('.tip')
  root.addEventListener('pointerover', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]')
    if (!el || !root.contains(el)) return
    tip.textContent = el.dataset.tip ?? ''
    tip.hidden = false
    const r = el.getBoundingClientRect()
    const base = body.getBoundingClientRect()
    tip.style.left = `${r.left + r.width / 2 - base.left}px`
    tip.style.top = `${r.top - base.top}px`
  })
  root.addEventListener('pointerout', (e) => {
    const el = (e.target as HTMLElement).closest('[data-tip]')
    if (el) tip.hidden = true
  })

  btn.addEventListener('click', () => load(true))
  load()
</script>

<style>
  .briefing {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .semaforo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .semaforo i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
    box-shadow: 0 0 10px currentColor;
  }
  .semaforo[data-tone='apretar'] i {
    background: var(--ok);
    color: var(--ok);
  }
  .semaforo[data-tone='controlar'] i {
    background: var(--warn);
    color: var(--warn);
  }
  .semaforo[data-tone='suave'] i {
    background: var(--accent);
    color: var(--accent);
  }
  .body {
    position: relative;
  }
  .titular {
    margin: 0.5rem 0 0.5rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.2;
    max-width: 44rem;
  }
  .skeleton {
    animation: pulse 1.4s ease-in-out infinite;
  }
  .titular.skeleton {
    color: var(--muted);
  }
  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }
  .motivo {
    margin: 0 0 1.5rem;
    max-width: 44rem;
    color: var(--muted);
    font-size: 0.9rem;
    min-height: 1.35em;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line);
  }
  .card {
    padding: 1rem 1.1rem 1.15rem;
    min-width: 0;
  }
  .card + .card {
    border-left: 1px solid var(--line);
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .card-head .label {
    margin: 0;
  }
  .total {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .total b {
    font-weight: 500;
    color: var(--fg);
  }
  .nombre {
    margin: 0.9rem 0 0.75rem;
    font-size: 1rem;
    min-height: 1.5em;
  }

  /* --- Sesión: barra segmentada -------------------------------------------- */
  .segments {
    display: flex;
    gap: 2px;
    height: 44px;
    min-height: 44px;
  }
  .pixels {
    display: none;
    grid-template-columns: repeat(16, 1fr);
    gap: 2px;
    height: 44px;
    margin-top: -44px;
  }
  .body[data-state='loading'] .pixels {
    display: grid;
  }
  .pixels i {
    display: block;
    background: var(--line);
    animation: pix 1.6s steps(1) infinite;
    animation-delay: var(--d);
  }
  @keyframes pix {
    0%,
    100% {
      background: var(--line);
    }
    25% {
      background: var(--faint);
    }
    50% {
      background: var(--accent);
    }
    75% {
      background: var(--faint);
    }
  }
  .body[data-state='loading'] .nombre {
    color: var(--faint);
  }
  .body[data-state='loading'] .nombre:empty::before {
    content: 'Preparando la sesión…';
  }
  .segments :global(.seg) {
    position: relative;
    flex-basis: 0;
    min-width: 6px;
    border-radius: 3px;
    background: var(--muted);
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: filter 0.15s;
  }
  .segments :global(.seg:hover) {
    filter: brightness(1.25);
  }
  .segments :global(.seg-km) {
    font-size: 0.7rem;
    color: var(--bg);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }
  .briefing :global(.calentamiento),
  .briefing :global(.enfriamiento) {
    background: var(--faint);
  }
  .briefing :global(.suave) {
    background: var(--muted);
  }
  .briefing :global(.maraton),
  .briefing :global(.rodaje) {
    background: var(--fg);
  }
  .briefing :global(.umbral),
  .briefing :global(.series),
  .briefing :global(.calidad) {
    background: var(--accent);
  }
  .briefing :global(.tirada) {
    background: var(--ok);
  }
  .segments :global(.calentamiento .seg-km),
  .segments :global(.enfriamiento .seg-km) {
    color: var(--fg);
    mix-blend-mode: normal;
  }
  .bloques {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .bloques :global(li) {
    display: grid;
    grid-template-columns: 8px 1fr auto auto;
    gap: 0.6rem;
    align-items: center;
    color: var(--muted);
  }
  .bloques :global(.b-tipo) {
    display: grid;
    line-height: 1.3;
    min-height: 2.6em;
    align-content: center;
  }
  .bloques :global(strong) {
    font-weight: 500;
    color: var(--fg);
  }
  .bloques :global(em) {
    font-style: normal;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bloques :global(em:empty) {
    display: none;
  }
  .bloques :global(b) {
    font-weight: 500;
    color: var(--fg);
    text-align: right;
  }
  .bloques :global(.ritmo) {
    min-width: 6.5rem;
  }
  .bloques :global(small) {
    font-size: 0.7em;
    color: var(--muted);
    margin-left: 0.1em;
  }
  .briefing :global(.sw) {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  /* --- Semana: hecho vs plan --------------------------------------------------- */
  .plan-label {
    color: var(--fg);
  }
  .chart {
    margin-top: 0.9rem;
  }
  .cols {
    display: flex;
    align-items: stretch;
    gap: 4px;
    height: 132px;
  }
  .col {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-rows: 1rem 1fr 1.1rem;
    gap: 0.25rem;
    align-items: end;
    text-align: center;
  }
  .col .num {
    font-size: 0.65rem;
    color: var(--muted);
    line-height: 1rem;
  }
  .col .bar {
    align-self: end;
    height: var(--h, 0%);
    min-height: 2px;
    border-radius: 3px 3px 0 0;
    transition:
      height 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.3s;
  }
  .col.hecho .bar,
  .sw.hecho {
    background:
      repeating-linear-gradient(135deg, var(--muted) 0 2px, transparent 2px 5px),
      var(--bg-2);
    border: 1px solid var(--faint);
    border-bottom: 0;
  }
  .sw.hecho {
    border-bottom: 1px solid var(--faint);
  }
  .col.hecho:hover .bar {
    border-color: var(--muted);
  }
  .col.plan:hover .bar {
    filter: brightness(1.25);
  }
  .col .bar.skeleton {
    background: var(--line);
  }
  .col .dia {
    font-size: 0.65rem;
    color: var(--faint);
    letter-spacing: 0.04em;
    line-height: 1.1rem;
  }
  .col.today .dia {
    color: var(--accent);
    font-weight: 600;
  }
  .col.today .num {
    color: var(--fg);
  }
  .divider {
    width: 1px;
    background: var(--line);
    margin: 0 3px;
  }
  .legend {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tools {
    margin: 1rem 0 0;
    font-size: 0.65rem;
    color: var(--faint);
    min-height: 1em;
  }
  .tip {
    position: absolute;
    z-index: 5;
    transform: translate(-50%, calc(-100% - 8px));
    padding: 0.35rem 0.6rem;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.72rem;
    white-space: nowrap;
    border-radius: 3px;
    pointer-events: none;
  }
  .body[data-state='loading'] .card {
    opacity: 0.7;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card + .card {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .head {
      flex-wrap: wrap;
    }
  }
</style>
